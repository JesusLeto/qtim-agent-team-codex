{
  "description": "Plugin-bundled Codex lifecycle contracts команды qtim: стартовый анонс и passive unfinished-mission advisory, handoff после субагента и opt-in screenshot gate для qtim-testing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); sh \"$PLUGIN_ROOT/hooks/session-start.sh\" \"$root\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\session-start.ps1\"",
            "statusMessage": "Checking qtim charter",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); test ! -f \"$root/.codex/team-charter.md\" || printf '%s\\n' '{\"systemMessage\":\"qtim: subagent завершился. Проверь реальные артефакты: изменённые файлы, отчёт, memory/, скриншоты/логи. Если артефактов нет — уточни у agent thread или проверь сам.\"}'",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\subagent-stop.ps1\"",
            "statusMessage": "Checking qtim subagent handoff",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^qtim-testing$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/screenshots-gate.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\hooks\\screenshots-gate.ps1\"",
            "statusMessage": "Checking qtim browser evidence",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
